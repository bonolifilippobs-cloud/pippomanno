# Your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# A long random password. The web app and the Siri Shortcut both send it.
APP_TOKEN=
# Fallback time zone when the client doesn't send one (Siri Shortcut).
TZ_DEFAULT=Europe/Rome
# Where the SQLite database lives. Point it at a persistent volume in production.
DATA_DIR=./data
PORT=3000
